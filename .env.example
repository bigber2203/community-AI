# U'R Map Configuration (MapLibre GL JS)
# Default is CARTO Voyager vector style (no API key required)
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json

# Default City Center (Guwahati coordinates)
VITE_MAP_DEFAULT_CENTER_LNG=91.7362
VITE_MAP_DEFAULT_CENTER_LAT=26.1445
VITE_MAP_DEFAULT_ZOOM=13
VITE_MAP_MIN_ZOOM=2
VITE_MAP_MAX_ZOOM=20

# 3D Building Extrusion Layer (true/false)
VITE_ENABLE_3D_BUILDINGS=true

# (Optional) Commercial map provider configurations
# VITE_MAPTILER_API_KEY=your_maptiler_api_key
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json
